# ModelForge — Root Environment Configuration
# Copy this file to .env and fill in your values before running docker-compose

# ── Required: Your Oracle Cloud VM public IP or domain ──────────
# This is baked into the frontend at build time
NEXT_PUBLIC_API_URL=http://YOUR_ORACLE_VM_PUBLIC_IP:8000

# ── CORS: Frontend origin(s) allowed to call the backend ────────
# Use your actual frontend URL (IP or domain)
CORS_ORIGINS=http://YOUR_ORACLE_VM_PUBLIC_IP:3000

# ── Training Timeout (seconds): Default 3600s (1 hour) ───────────
MAX_TRAINING_TIMEOUT_SECONDS=3600

